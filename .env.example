# ==============================================================================
# Environment Configuration Template
# Project: Containerized Public Toilet Maintenance Tracker
# Task 13: Configuration Management & Drift Prevention
# ==============================================================================
# Usage: Copy this template to '.env' and customize for the target environment.
# Note: '.env' is ignored by Git to prevent credential leaks.
# ==============================================================================

# Host Application Port (Forwarded to container port 8081)
APP_PORT=8085

# Active Spring Boot Profile (dev = H2 in-memory, docker = PostgreSQL container)
SPRING_PROFILES_ACTIVE=docker

# Relational Database Parameters (PostgreSQL 15)
POSTGRES_DB=toilet_tracker_db
POSTGRES_USER=tracker_user
POSTGRES_PASSWORD=change_me_to_a_secure_password
DB_HOST=public-toilet-db
DB_PORT=5432

# Spring Datasource Connection Properties
SPRING_DATASOURCE_URL=jdbc:postgresql://public-toilet-db:5432/toilet_tracker_db
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect
SPRING_JPA_HIBERNATE_DDL_AUTO=update
